# ---- 阶段 1：安装全量依赖并构建服务端 bundle ----
ARG NODE_VERSION=24.1.0
FROM node:${NODE_VERSION}-slim AS builder

WORKDIR /app
COPY package.json package-lock.json ./

RUN --mount=type=cache,target=/root/.npm \
    npm ci

COPY . .
RUN npm run build:game:bundle

# ---- 阶段 2：仅安装生产依赖 ----
ARG NODE_VERSION=24.1.0
FROM node:${NODE_VERSION}-slim AS deps

WORKDIR /app
COPY package.json package-lock.json ./

# 使用 npm 镜像源加速下载（可选，国内环境推荐）
# RUN npm config set registry https://registry.npmmirror.com

# 安装生产依赖（利用 BuildKit 缓存挂载加速）
RUN --mount=type=cache,target=/root/.npm \
    npm ci --omit=dev --ignore-scripts
COPY scripts/deploy/prune-prod-node-modules.mjs ./scripts/deploy/prune-prod-node-modules.mjs
RUN node scripts/deploy/prune-prod-node-modules.mjs --profile game

# ---- 阶段 3：最终生产镜像 ----
FROM node:${NODE_VERSION}-slim

WORKDIR /app

# 生产依赖（不含 devDependencies，体积大幅缩小）
COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY --from=builder /app/temp/prod-bundles/game/server.mjs ./server.mjs
COPY --from=builder /app/temp/prod-bundles/game/server.mjs.map ./server.mjs.map

ENV GAME_SERVER_PORT=18000
ENV NODE_ENV=production
EXPOSE 18000

CMD ["node", "--enable-source-maps", "server.mjs"]
