[Unit]
Description=BoardGame manual R2 disaster rebuild
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=admin
Group=admin
Environment=HOME=/home/admin
WorkingDirectory=/home/admin/storage/assets/control
ExecStart=/usr/bin/node /home/admin/storage/assets/control/sync-active-r2-assets.mjs --remote r2-boardgame:boardgame-assets --assets-root /home/admin/storage/assets --bwlimit 4M
Nice=15
IOSchedulingClass=idle
CPUQuota=25%
IOWeight=10
MemoryMax=256M
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/admin/storage/assets
ReadOnlyPaths=/home/admin/.config/rclone
