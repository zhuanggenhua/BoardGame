      "prompt": "当前工作区刚跑完真实交互截图，请做最终玩家视角审计。",
      "fixture": {
        "score": 94,
        "hard_failures": [],
        "same_source": true,
        "screenshot_postdates_edit": true
      },
      "expected": {
        "trigger": true,
        "verdict": "PASS",
        "required_actions": [
          "write_visual_judgment",
          "open_final_original_with_show_image_to_user"
        ]
      }
    },
    {
      "id": "stale-evidence-boundary",
