          "measure_banner_center",
          "measure_target_center",
          "assert_shared_viewport_axis",
          "recapture_and_reaudit"
        ]
      }
    },
    {
      "id": "readable-skill-showcase-auto-dismiss",
      "type": "positive",
      "prompt": "规则要求玩家读完后手动关闭的对手技能特写刚出现就因 3 秒 timer 自动关闭，E2E 只检查它出现过一瞬间，这能通过吗？",
      "expected": {
        "trigger": true,
