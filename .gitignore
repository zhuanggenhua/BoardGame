# 资源与美术/音效（避免远程仓库体积膨胀；资源走对象存储/CDN）
# - public/assets/ 默认忽略全部资源
# - 仅允许提交 assets-manifest.json 与 public/assets/demo/ 下的少量示例资源
# - public/assets/i18n/zh-CN/* 为符号链接（本地构建产物），不提交
public/assets/**
**/*.png
!evidence/**/assets/**/*.png
!evidence/**/screenshots/**/*.png
!evidence/**/_captured/**/*.png
!src/games/qidahen/data/region-mask.png
!src/games/qidahen/data/region-boundary-add.png
!src/games/qidahen/data/region-boundary-remove.png
public/**/*.jpg
public/**/*.jpeg
public/**/*.gif
public/**/*.webp
public/**/*.avif
public/**/*.tiff
public/**/*.bmp
public/**/*.ico
public/**/*.wav
public/**/*.ogg
public/**/*.mp3
public/**/*.flac
public/**/*.m4a
!public/assets/
!public/assets/i18n/
!public/assets/i18n/zh-CN/
!public/assets/i18n/zh-CN/qidahen/
!public/assets/i18n/zh-CN/qidahen/thumbnails/
!public/assets/i18n/zh-CN/qidahen/thumbnails/**/
!public/assets/i18n/zh-CN/qidahen/thumbnails/**/*.webp
public/**/*.mp4
public/**/*.webm

# Home V2 书本壳素材需要跟仓，不能继续被资源忽略规则吞掉
!public/assets/common/images/home-v2/
!public/assets/common/images/home-v2/**

# 资源清单与 demo 例外
!public/assets/
