public/**/*.jpeg
public/**/*.gif
public/**/*.webp
public/**/*.avif
public/**/*.tiff
public/**/*.bmp
public/**/*.ico
public/**/*.wav
public/**/*.ogg
public/**/*.mp3
public/**/*.flac
public/**/*.m4a
!public/assets/
!public/assets/i18n/
!public/assets/i18n/zh-CN/
public/**/*.mp4
public/**/*.webm

# 资源清单可随源码提交；任何游戏媒体素材一律不入仓。
!public/assets/
!public/assets/**/
!public/assets/**/assets-manifest.json
!public/assets/**/*.json

# 赞助二维码等小图（允许提交）
!public/logos/
!public/logos/**

