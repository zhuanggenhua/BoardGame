  "tutorial": {
    "chapters": {
      "basic": {
        "title": "首局流程：读局、计划与常见结算",
        "description": "从胜利条件、法师读数、聚魔和计划开始，接着走召唤、移动、墙体、守卫、治疗和状态移除。"
      },
      "wallAndLineOfSight": {
        "title": "续段：墙体边界、视线与通行伤害",
        "description": "墙体放置在区域边界上；阻挡视线时不能将对象或区域作为目标。"
      },
      "guard": {
        "title": "续段：守卫",
        "description": "生物能选择使用一个快速行动进行守卫，以保护它所在区域并获得反击特性。"
      },
      "healing": {
        "title": "续段：治疗",
        "description": "治疗能从活体生物和魔物上移除伤害。"
      },
      "restoreAndBurn": {
        "title": "续段：燃烧与复原术",
        "description": "燃烧标记的移除费用为2点；复原术可支付对应移除费用移除状态标记。"
      }
    },
    "wallAndLineOfSight": {
      "steps": {
        "setup": "部署阶段继续看墙体。墙体被放置在区域边界上（两格区域之间的线条）。",
        "wallPurpose": "墙体为魔物类法术的子类型。墙体永远被放置在区域边界上。",
        "castThornsWall": "选择准备区的“荆棘之墙”，再点击左后区与中左后区之间的边界。被高亮的是合法墙体边界，不是整格目标。",
        "wallCardOnEdge": "墙体结算后，边界上显示“荆棘之墙”牌面。该边界已有墙体。",
        "lineOfSightAndPassage": "如果对某对象或区域的视线被阻挡，则你不能将其作为目标。所有穿越本墙体的生物均将自动受到墙体的攻击；本攻击在生物移动之前发生。"
      }
    },
    "guard": {
      "steps": {
        "setup": "行动阶段继续看守卫。生物能选择使用一个快速行动进行守卫，以保护它所在区域并获得反击特性。",
        "guardRule": "在进行近战攻击时，如果你所在区域内有敌方的守卫，则你必须攻击敌方守卫。近战攻击将移除守卫生物上的守卫标记。",
        "guardCleric": "点击右侧的阿希拉牧师，再点击屏幕中下行动条里的“进行守卫”。守卫标记是结算后的状态，不是要先点击的技能或目标。",
        "guardTokenResult": "阿希拉牧师获得守卫标记。守卫标记位于单位牌面正下方。"
      }
    },
    "healing": {
      "steps": {
        "setup": "行动阶段继续看治疗。治疗能从活体生物和魔物上移除伤害。",
        "healingRule": "阿希拉牧师：治疗之光为完整行动能力，距离 0-1，目标为活体生物，治疗效果等于掷骰结果。",
        "healWoundedBobcat": "点击同格的阿希拉牧师，点击“治疗之光”，再点击受伤的野性山猫。",
        "healingResultAndLifeReadout": "治疗能从活体生物和魔物上移除伤害。野性山猫的伤害降低；生命读数显示当前剩余生命。",
        "lifeToggle": "点击眼睛按钮显示全部生命读数；再点击一次关闭常显。"
      }
    },
    "restoreAndBurn": {
      "steps": {
        "setup": "状态处理继续看燃烧与复原术。燃烧标记的移除费用为2点。",
        "burnRule": "燃烧表明对象正在着火，是一种火焰状态。在每个维持阶段，每个对象上每有一枚燃烧标记，投掷1颗攻击骰子，造成直接伤害。投掷出“0”时，移除该燃烧标记。",
        "restoreBurningCleric": "点击女祭司法师本体，点击“复原术”，再点击带燃烧标记的阿希拉牧师。复原术距离 1 格内目标生物，支付对应移除费用移除一类状态标记。",
        "restoreResult": "燃烧标记已移除。状态移除后，目标卡牌上的燃烧标记消失，法师法力和行动标记也已改变。"
      }
    },
    "steps": {
      "intro": "法师战争中，游戏将持续数个回合，直到一方法师受到的伤害足以将其毁灭。最后一个屹立不倒的法师赢得游戏的胜利。",
      "selfHud": "你的法师面板显示生命、伤害、法力、聚魔、行动标记和快速施法标记。学徒法师起始生命24、初始法力10、聚魔10；目标是让对方法师累计足够伤害并被击败。",
      "opponentHud": "对手面板同样显示这些读数。对手的已计划法术用牌背和数量表示，未公开前不能看见牌名。",
      "stage": "每个游戏回合分为准备环节和行动环节。准备环节完成后行动环节才会开始。",
      "advanceChannel": "点击“回合结束”完成重置阶段。聚魔阶段每名法师将等同于其聚魔点数的法力加入到法力池中。",
      "channelResult": "兽王当前聚魔为10；聚魔后法力池加入10点法力。",
      "advanceUpkeep": "某些法术会有维持费用；某些法术与状态将在维持阶段生效。本局当前没有要支付的维持费用，点击“回合结束”。",
      "advancePlanning": "计划阶段：每名法师从各自的法术书中为本回合选择最多2个法术。点击“回合结束”打开法术书。",
      "planWolf": "先点“生物”分类，点下一页选择“丛林灰狼”；再点“咒语”分类，点下一页选择“兽性觉醒”，然后点击“确认计划（2张）”。兽性觉醒：选择一个本回合被召唤的生物，将目标生物的行动标记翻转至活动面。",
      "preparedAndHidden": "双方玩家同时选择各自的法术。你所选择的法术对你的对手保密，以使他无法得知你的计划。",
      "deployWolf": "选择准备区的“丛林灰狼”，再点击兽王所在区域。召唤：当你施放一个生物类法术时，也被称为“召唤”一个生物。",
