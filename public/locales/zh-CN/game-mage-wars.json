  "tutorial": {
    "steps": {
      "intro": "击败对方法师才能获胜。兽王依靠聚魔攒法力、计划法术、召唤生物，再用位置和攻击压迫对手。",
      "selfHud": "兽王有 24 点生命、10 点聚魔和法力池。法力支付召唤与咒语；伤害累积到生命上限时会输。",
      "stage": "阶段条显示本回合走到哪里。准备阶段双方都确认后才进入下一阶段，行动阶段会按玩家顺序处理。",
      "advanceChannel": "点击“回合结束”完成重置准备。双方确认后进入聚魔，兽王会获得本回合的法力收入。",
      "channelResult": "聚魔让兽王获得 10 点法力。这个回合有足够法力召唤丛林灰狼，并保留一张咒语让它马上行动。",
      "advanceUpkeep": "维持阶段处理持续效果和状态。本局还没有持续消耗，点击“回合结束”继续进入计划阶段。",
      "advancePlanning": "计划阶段从法术书秘密选择最多两张牌。点击“回合结束”，打开本回合要准备的法术选择。",
      "planWolf": "在法术书选择“丛林灰狼”，切到“咒语”再选“兽性觉醒”，然后点击“计划 2 张”。这是一组召唤后立刻行动的组合。",
      "preparedAndHidden": "你准备的两张牌在下方；对手也有隐藏准备牌。准备牌会在施放后进入弃牌堆，未公开前对手不知道内容。",
      "deployWolf": "选择准备区的“丛林灰狼”，再点击兽王所在区域召唤。灰狼会进场，但刚召唤的生物行动标记先用完。",
      "rouseWolf": "选择准备区的“兽性觉醒”，再点击场上的丛林灰狼。这个咒语会把本回合刚召唤的生物翻回活动面。",
      "passYourDeployment": "灰狼已经可以行动。部署阶段交给对手后，对手会公开刚才准备的法术。",
      "opponentDeploy": "对手召唤阿希拉牧师。公开的对手生物会留在竞技场上，生命、护甲和伤害都可以直接查看。",
      "opponentAttackSpell": "对手施放圣光之柱，攻击场上的牧师。法术攻击会显示骰子结果、伤害和可能出现的状态。",
      "discardReading": "弃牌堆记录已经公开并结算过的法术。看到圣光之柱进弃牌堆，就能判断对手少了一张攻击法术。",
      "skipToCreatureAction": "双方快速施法都放弃后，回合进入生物行动。被兽性觉醒唤醒的丛林灰狼还能移动。",
      "moveWolf": "点击丛林灰狼，再点击相邻区域移动。移动后灰狼离中线更近，下一次行动可以威胁更多目标。",
      "finish": "你已经完成一段基础回合：聚魔、计划、召唤、唤醒、读对手公开信息，再把生物推进到更有威胁的位置。"
    }
  },
